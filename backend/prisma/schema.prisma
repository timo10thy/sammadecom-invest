generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INVESTOR
  STAFF
  FINANCE
  MANAGEMENT
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  MATURED
  PAID
}

enum PaymentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSED
}

enum InvestorStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investorProfile   Investor?
  submittedPayments Payment[] @relation("SubmittedBy")
  approvedPayments  Payment[] @relation("ApprovedBy")
  auditLogs         AuditLog[]
  refreshTokens RefreshToken[]
}

model Investor {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  status InvestorStatus @default(PENDING)


  phone   String
  address String?

  bankAccountEncrypted String?
  bankAccountLast4     String?
  bankName             String?

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Investment {
  id         String           @id @default(uuid())
  investorId String
  investor   Investor         @relation(fields: [investorId], references: [id])

  planName     String
  amount       Decimal
  startDate    DateTime
  maturityDate DateTime
  status       InvestmentStatus @default(PENDING)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id           String        @id @default(uuid())
  investmentId String
  investment   Investment    @relation(fields: [investmentId], references: [id])

  amount Decimal
  status PaymentStatus @default(PENDING_APPROVAL)

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String

  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}