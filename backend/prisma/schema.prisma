generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INVESTOR
  STAFF
  FINANCE
  MANAGEMENT
  SYSTEM
}

enum InvestmentStatus {
  PENDING
  FINANCE_VERIFIED
  ACTIVE
  MATURED
  PAID
  RETURNED
  REJECTED
}

enum PaymentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSED
}

enum InvestorStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investorProfile   Investor?      @relation("InvestorUser")
  reviewedInvestors Investor[]     @relation("InvestorReviewedBy")
  submittedPayments Payment[]      @relation("SubmittedBy")
  approvedPayments  Payment[]      @relation("ApprovedBy")
  auditLogs         AuditLog[]
  createdDeposits            Deposit[]    @relation("DepositCreatedBy")
  createdInvestments         Investment[] @relation("InvestmentCreatedBy")
  financeVerifiedInvestments Investment[] @relation("InvestmentFinanceVerifiedBy")
  approvedInvestments        Investment[] @relation("InvestmentApprovedBy")
  processedPayments          Payment[]    @relation("ProcessedBy")
  refreshTokens     RefreshToken[]
}

model Investor {
  id     String         @id @default(uuid())
  userId String         @unique
  user   User           @relation("InvestorUser", fields: [userId], references: [id])
  status InvestorStatus @default(PENDING)

  reviewedById    String?
  reviewedBy      User?     @relation("InvestorReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  phone   String
  address String?

  bankAccountEncrypted String?
  bankAccountLast4     String?
  bankName             String?

  investments Investment[]
  deposits    Deposit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Investment {
  id         String   @id @default(uuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])

  depositId String
  deposit   Deposit @relation(fields: [depositId], references: [id])

  planName   String
  amount     Decimal
  roiPercent Decimal @db.Decimal(5, 2)

  startDate    DateTime?
  maturityDate DateTime?
  status       InvestmentStatus @default(PENDING)

  createdById String
  createdBy   User   @relation("InvestmentCreatedBy", fields: [createdById], references: [id])

  financeVerifiedById String?
  financeVerifiedBy   User?     @relation("InvestmentFinanceVerifiedBy", fields: [financeVerifiedById], references: [id])
  financeVerifiedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("InvestmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  reviewReason String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depositId])
  @@index([status])
}

model Deposit {
  id         String   @id @default(uuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])

  reference   String   @unique
  totalAmount Decimal  @db.Decimal(14, 2)
  datePaid    DateTime

  createdById String
  createdBy   User   @relation("DepositCreatedBy", fields: [createdById], references: [id])

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([investorId])
}

model Payment {
  id           String     @id @default(uuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])

  amount Decimal
  status PaymentStatus @default(PENDING_APPROVAL)

  // copy of the investor's encrypted bank account when the Payment was submitted
  bankAccountSnapshot String

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  rejectionReason String?

  processedById String?
  processedBy   User?     @relation("ProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?
  bankReference String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([investmentId])
  @@index([status])
}
model AuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String
  details    String?

  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])

  usedAt    DateTime?
}